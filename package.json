{
  "name": "nicolive-recorder",
  "productName": "Nico Live Message Recorder",
  "version": "0.1.0-beta.21",
  "description": "ニコニコ生放送の配信ストリーム・コメント保存ツール",
  "main": "electron/main.cjs",
  "author": "kanenao",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "npm run prepare:streamlink && electron-builder --win nsis zip --publish never",
    "pack": "npm run prepare:streamlink && electron-builder --dir",
    "test": "node --test",
    "prepare:streamlink": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-streamlink.ps1",
    "dist:win:release": "npm run prepare:streamlink && electron-builder --win nsis zip --publish always"
  },
  "dependencies": {
    "@n-air-app/nicolive-comment-protobuf": "github:Segu-g/nicolive-comment-protobuf#v2025.602.163750-segument",
    "nicomget": "github:Segu-g/nicomget",
    "ws": "^8.18.0",
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "jp.kanenao.nicolive.recorder",
    "productName": "Nico Live Message Recorder",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**/*",
      "index.html",
      "renderer.js",
      "styles.css",
      "package.json",
      "node_modules/**/*",
      "composition.js",
      "THIRD-PARTY-NOTICES.md",
      "scripts/patch-nicolive.cjs"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "publish": [
        {
          "provider": "github",
          "owner": "kanenao",
          "repo": "-Nico-Live-Message-Recorder",
          "releaseType": "prerelease",
          "channel": "beta"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nico Live Message Recorder",
      "include": "build/installer.nsh"
    },
    "extraResources": [
      {
        "from": "vendor/streamlink",
        "to": "streamlink",
        "filter": [
          "**/*"
        ]
      }
    ],
    "generateUpdatesFilesForAllChannels": true
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kanenao/-Nico-Live-Message-Recorder.git"
  }
}
